# Core
PROJECT_NAME=GaNIndustry Monitor-assistant
# Local dev keeps the DB in the repo. On Railway, mount a persistent Volume (e.g.
# at /data) and set DB_URL=sqlite:////data/ganiq.db (4 slashes = absolute path) so
# data survives redeploys. First boot auto-seeds the volume from the repo snapshot.
DB_URL=sqlite:///./data/ganiq.db
TIMEZONE=Asia/Taipei

# Ingestion / scheduler
INGEST_INTERVAL_MINUTES=120
STOCK_INTERVAL_MINUTES=30
WEEKLY_CRON_DAY_OF_WEEK=mon,thu
WEEKLY_CRON_HOUR=7
WEEKLY_CRON_MINUTE=0
MAX_ARTICLES_PER_SOURCE=20

# DeepSeek
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=35

# Gmail sender/receiver
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USER=your_backup_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_TO=your_work_gmail@gmail.com
GMAIL_FROM_DISPLAY_NAME=GaN Intelligence Bot

# Trackable GaN-related tickers (Yahoo Finance symbols)
STOCK_TICKERS_CSV=NVTS,ON,STM,IFNNY,WOLF,TXN,RNECY,MCHP,ADI
